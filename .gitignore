# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Test, lint, type-check, and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Packaging and build artifacts
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Local environment files and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local datasets and generated experiment artifacts. These are anchored to the
# repository root with a leading slash so they cannot match package directories
# such as src/grit/data/.
/data/
/outputs/
/checkpoints/
/artifacts/
/wandb/
/wandb_data/
/scratch/

# Local logs and scheduler output
*.log
slurm-*.out
